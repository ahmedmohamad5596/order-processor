{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "python3 -m venv /app/.venv",
        "/app/.venv/bin/pip install -r /app/requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}