{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        { "src": "requirements.txt", "dest": "requirements.txt" },
        { "path": "/mise/shims" },
        "python3 -m pip install -r requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}