{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "python3 -m venv /app/.venv",
        "/app/.venv/bin/pip install 'rapidfuzz>=3.0.0' 'openpyxl>=3.1.0' 'aiohttp>=3.9.0'"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}